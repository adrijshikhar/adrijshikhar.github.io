---
import '../styles/globals.css';
import '../styles/machine.css';
import ThemeSwitcher from '../components/ThemeSwitcher.tsx';

interface Props {
  title: string;
  canonical?: string;
}

const { title, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- No-FOUC: apply saved accent theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var valid = ['parallel', 'teal', 'rausch', 'violet', 'hyperlink', 'signal'];
          var saved = localStorage.getItem('theme');
          document.documentElement.dataset.theme =
            saved && valid.indexOf(saved) !== -1 ? saved : 'parallel';
        } catch (e) {
          document.documentElement.dataset.theme = 'parallel';
        }
      })();
    </script>
  </head>
  <body class="antialiased text-text">
    <!-- Ambient aurora: faint accent-tinted drifting blobs behind everything.
         Static under reduced-motion; hidden in machine mode (see globals.css). -->
    <div class="aurora-stage" aria-hidden="true">
      <div class="aurora-blob aurora-blob--1"></div>
      <div class="aurora-blob aurora-blob--2"></div>
      <div class="aurora-blob aurora-blob--3"></div>
    </div>

    <div class="pointer-events-none fixed z-[9999] hidden lg:block" id="cursor">
      <div class="relative -left-2 -top-2 h-4 w-4 border border-muted transition-all duration-[120ms] ease-out" id="cursor-dot"></div>
    </div>
    <slot />

    <!-- Accent theme switcher, docked beside the human/machine toggle -->
    <div class="fixed bottom-6 left-1/2 z-[1090] -translate-x-1/2 translate-y-[calc(100%+0.625rem)] sm:translate-y-0 sm:left-auto sm:right-6 sm:bottom-7">
      <div class="flex items-center border border-border bg-surface/90 px-3 py-2 backdrop-blur-xl">
        <ThemeSwitcher client:load />
      </div>
    </div>

    <script>
      const cursor = document.getElementById('cursor');
      const cursorDot = document.getElementById('cursor-dot');
      if (cursor) {
        cursor.style.left = `${window.innerWidth * 0.07}px`;
        cursor.style.top = `${window.innerHeight * 0.5}px`;
      }
      document.addEventListener('mousemove', (e) => {
        if (cursor) {
          cursor.style.left = `${e.clientX}px`;
          cursor.style.top = `${e.clientY}px`;
        }
      });
      document.querySelectorAll('a, button').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          cursorDot?.classList.add('scale-150');
          cursorDot?.style.setProperty('border-color', 'var(--accent)');
        });
        el.addEventListener('mouseleave', () => {
          cursorDot?.classList.remove('scale-150');
          cursorDot?.style.removeProperty('border-color');
        });
      });
    </script>
  </body>
</html>
