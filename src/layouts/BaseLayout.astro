---
import '../styles/globals.css';
import '../styles/machine.css';

interface Props {
  title: string;
  canonical?: string;
}

const { title, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>
  <body class="antialiased bg-slate-900 text-slate-400">
    <div class="pointer-events-none fixed z-[9999] hidden lg:block" id="cursor">
      <div class="relative -left-2 -top-2 h-4 w-4 rounded-full border-2 border-slate-300/80 transition-all duration-150 ease-out" id="cursor-dot"></div>
    </div>
    <slot />
    <script>
      const cursor = document.getElementById('cursor');
      const cursorDot = document.getElementById('cursor-dot');
      if (cursor) {
        cursor.style.left = `${window.innerWidth * 0.07}px`;
        cursor.style.top = `${window.innerHeight * 0.5}px`;
      }
      document.addEventListener('mousemove', (e) => {
        if (cursor) {
          cursor.style.left = `${e.clientX}px`;
          cursor.style.top = `${e.clientY}px`;
        }
      });
      document.querySelectorAll('a, button').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          cursorDot?.classList.add('scale-150', 'border-accent/50');
          cursorDot?.classList.remove('border-slate-300/80');
        });
        el.addEventListener('mouseleave', () => {
          cursorDot?.classList.remove('scale-150', 'border-accent/50');
          cursorDot?.classList.add('border-slate-300/80');
        });
      });
    </script>
  </body>
</html>
