---
import '../styles/globals.css';
import '../styles/machine.css';

interface Props {
  title: string;
  canonical?: string;
}

const { title, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- No-FOUC: apply saved accent theme + light/dark mode before first paint -->
    <script is:inline>
      (function () {
        try {
          var allowed = ['red', 'parallel', 'blue', 'teal', 'violet', 'signal'];
          var t = localStorage.getItem('theme');
          if (!allowed.includes(t)) t = 'red';
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'red';
        }
        try {
          // ?mode= URL override wins, else saved mode, else default LIGHT (E's default;
          // dark is the added variant — the reverse of design G whose default is dark).
          var urlMode = new URLSearchParams(location.search).get('mode');
          var savedMode =
            urlMode === 'light' || urlMode === 'dark'
              ? urlMode
              : localStorage.getItem('mode');
          document.documentElement.dataset.mode =
            savedMode === 'dark' ? 'dark' : 'light';
        } catch (e) {
          document.documentElement.dataset.mode = 'light';
        }
      })();
    </script>
  </head>
  <body class="antialiased">
    <!-- Geometric Bauhaus cursor: a hard accent quarter-square -->
    <div class="pointer-events-none fixed z-[9999] hidden lg:block" id="cursor">
      <div
        class="relative -left-[7px] -top-[7px] h-[14px] w-[14px] transition-transform duration-150 ease-out"
        id="cursor-dot"
        style="background: var(--accent); box-shadow: 0 0 0 1.5px var(--ink);"
      ></div>
    </div>
    <slot />
    <script>
      const cursor = document.getElementById('cursor');
      const cursorDot = document.getElementById('cursor-dot');
      if (cursor) {
        cursor.style.left = `${window.innerWidth * 0.07}px`;
        cursor.style.top = `${window.innerHeight * 0.5}px`;
      }
      document.addEventListener('mousemove', (e) => {
        if (cursor) {
          cursor.style.left = `${e.clientX}px`;
          cursor.style.top = `${e.clientY}px`;
        }
      });
      document.querySelectorAll('a, button').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          // hard scale + rotate into a diamond — geometric, snappy
          cursorDot?.classList.add('scale-[1.9]', 'rotate-45');
        });
        el.addEventListener('mouseleave', () => {
          cursorDot?.classList.remove('scale-[1.9]', 'rotate-45');
        });
      });
    </script>
  </body>
</html>
