---
import '../styles/globals.css';
import '../styles/machine.css';
import ModeToggle from '../components/ModeToggle.tsx';
import SkyField from '../components/SkyField.tsx';

interface Props {
  title: string;
  canonical?: string;
  skyMode?: 'full' | 'quiet';
  description?: string;
  /** 'article' for blog posts, so they can carry a published date. */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
}

const {
  title,
  canonical,
  skyMode = 'quiet',
  description = 'Senior software engineer at Hevo Data. I move data between systems that were never designed to agree, and write down what breaks on the way.',
  ogType = 'website',
  publishedAt,
} = Astro.props;

// Social images must be absolute — every platform drops a relative og:image.
// Astro.site is set in astro.config.mjs, so these resolve against the real
// origin in production and against localhost in dev.
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const twitterImage = new URL('/twitter-image.jpg', Astro.site).href;
const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Cloudflare Web Analytics beacon — token is public (ships in client HTML).
// Resolved from a .env file (local dev) or a shell/CI env var (GitHub Actions).
// Unset → no beacon emitted.
const cfBeaconToken =
  import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? process.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- No-FOUC: apply light/dark mode before first paint.
         MUST stay first in <head>, before any stylesheet <link> — a stylesheet placed
         before an inline script delays the script, which lets a default-dark frame paint. -->
    <script is:inline>
      (function () {
        try {
          var urlMode = new URLSearchParams(location.search).get('mode');
          var stored = localStorage.getItem('mode');
          var mode;
          if (urlMode === 'light' || urlMode === 'dark') {
            mode = urlMode;
          } else if (stored === 'light' || stored === 'dark') {
            mode = stored;
          } else {
            // No explicit choice yet — follow the OS/browser preference.
            mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.mode = mode;
        } catch (e) {
          document.documentElement.dataset.mode = 'dark';
        }
        try {
          // No-FOUC: a direct ?machine=true load must not flash the human view before the
          // ViewToggle island hydrates. Mark the document now; machine.css hides .human-view
          // and reveals .machine-view under .machine-boot, and the island clears it on mount.
          if (new URLSearchParams(location.search).get('machine') === 'true') {
            document.documentElement.classList.add('machine-boot', 'machine-mode');
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- Favicon set: SVG-first (modern), .ico fallback (legacy), apple-touch, manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Matches the painted ground: --bg resolved to sRGB, not the old neutral. -->
    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070a0e" media="(prefers-color-scheme: dark)" />

    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="adrijshikhar.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Adrij Shikhar — senior software engineer, Bengaluru" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImage} />
    <meta name="twitter:image:alt" content="Adrij Shikhar — senior software engineer, Bengaluru" />
    {
      cfBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
  </head>
  <body class="antialiased text-text">
    <SkyField client:visible mode={skyMode} />

    <!-- Viewfinder: corner brackets plus the top-edge measurement scale, ported
         from the prototype's `.frame`. Decoration only — the sky carries the
         meaning; this just makes the page read as something seen THROUGH an
         instrument rather than a document with a sky behind it. -->
    <div class="viewfinder" aria-hidden="true"><i></i><i></i><i></i><i></i><u></u></div>

    <slot />

    <!-- Light/dark mode toggle, docked top-right -->
    <div class="fixed top-5 right-5 z-[1090] md:top-6 md:right-6">
      <div class="flex items-center rounded-xl border border-[rgb(var(--border)/0.14)] bg-[color-mix(in_srgb,var(--surface)_92%,transparent)] px-3 py-2.5 shadow-[var(--card-shadow)] backdrop-blur-xl">
        <ModeToggle client:load />
      </div>
    </div>
  </body>
</html>
