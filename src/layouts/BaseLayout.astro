---
import '../styles/globals.css';
import '../styles/machine.css';
import SkyField from '../components/SkyField.tsx';

interface Props {
  title: string;
  canonical?: string;
  skyMode?: 'full' | 'quiet';
  description?: string;
  /** 'article' for blog posts, so they can carry a published date. */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
}

const {
  title,
  canonical,
  skyMode = 'quiet',
  description = 'Senior software engineer at Hevo Data. I move data between systems that were never designed to agree, and write down what breaks on the way.',
  ogType = 'website',
  publishedAt,
} = Astro.props;

// Social images must be absolute — every platform drops a relative og:image.
// Astro.site is set in astro.config.mjs, so these resolve against the real
// origin in production and against localhost in dev.
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const twitterImage = new URL('/twitter-image.jpg', Astro.site).href;
const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Cloudflare Web Analytics beacon — token is public (ships in client HTML).
// Resolved from a .env file (local dev) or a shell/CI env var (GitHub Actions).
// Unset → no beacon emitted.
const cfBeaconToken =
  import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? process.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- No-FOUC. The site is dark only (see design/README.md), so mode is stamped
         unconditionally; ?mode= and the stored preference are gone with light mode.
         MUST stay first in <head>, before any stylesheet <link> — a stylesheet placed
         before an inline script delays the script, which lets an unstyled frame paint. -->
    <script is:inline>
      document.documentElement.dataset.mode = 'dark';
      try {
        // A direct ?machine=true load must not flash the human view before the
        // ViewToggle island hydrates. machine.css hides .human-view and reveals
        // .machine-view under .machine-boot; the island clears it on mount.
        if (new URLSearchParams(location.search).get('machine') === 'true') {
          document.documentElement.classList.add('machine-boot', 'machine-mode');
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- Favicon set: SVG-first (modern), .ico fallback (legacy), apple-touch, manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Matches the painted ground: --bg resolved to sRGB, not the old neutral. -->
    <meta name="theme-color" content="#1E222A" />

    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="adrijshikhar.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Adrij Shikhar — senior software engineer, Bengaluru" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImage} />
    <meta name="twitter:image:alt" content="Adrij Shikhar — senior software engineer, Bengaluru" />
    {
      cfBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
  </head>
  <body class="antialiased text-text">
    <!-- Skip link, first focusable thing on the page. index.astro already carries
         <main id="content">; without this, keyboard users tab the whole rail and
         the sky easter egg before reaching any content. -->
    <a href="#content" class="skip-link">Skip to content</a>
    <aside aria-label="Sky instrument">
      <SkyField client:visible mode={skyMode} />
    </aside>

    <!-- Viewfinder: corner brackets plus the top-edge measurement scale, ported
         from the prototype's `.frame`. Decoration only — the sky carries the
         meaning; this just makes the page read as something seen THROUGH an
         instrument rather than a document with a sky behind it. -->
    <div class="viewfinder" aria-hidden="true"><i></i><i></i><i></i><i></i><u></u></div>

    <slot />

    <script is:inline>
      // Marks the document once the reader has left the first screen, so the
      // hero's scroll cue can retire. Passive, and it unbinds after the first
      // trip past the threshold rather than staying on the scroll path.
      (function () {
        var mark = function () {
          if (scrollY > window.innerHeight * 0.35) {
            document.body.classList.add('scrolled');
            removeEventListener('scroll', mark);
          }
        };
        addEventListener('scroll', mark, { passive: true });
        mark();
      })();
    </script>

</div>
  </body>
</html>
