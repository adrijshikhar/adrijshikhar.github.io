---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import matter from 'gray-matter';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import SideRail from '../components/SideRail.astro';
import ExpCard from '../components/ExpCard.tsx';
import ProjectCard from '../components/ProjectCard.tsx';
import BlogCard from '../components/BlogCard.tsx';
import ViewToggle from '../components/ViewToggle.tsx';
import { buildRawMarkdown } from '../lib/raw-markdown';
import { STARS } from '../lib/sky/catalogue';

const STAR_COUNT = STARS.length;

function readContent(filename: string) {
  const raw = readFileSync(join(process.cwd(), 'src/content', filename), 'utf-8');
  const { data, content } = matter(raw);
  return { meta: data, content };
}

function splitBySlug(content: string): Record<string, string> {
  const sections: Record<string, string> = {};
  const parts = content.split(/<!--\s*([\w-]+)\s*-->/);
  for (let i = 1; i < parts.length; i += 2) {
    sections[parts[i]] = parts[i + 1]?.trim() || '';
  }
  return sections;
}

const about = readContent('about.md');
const experience = readContent('experience.md');
const projects = readContent('projects.md');
const education = readContent('education.md');
// skills.md removed from rendered sections
const achievements = readContent('achievements.md');
const interests = readContent('interests.md');

const projSections = splitBySlug(projects.content);

const latestPosts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmtPostDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

// Machine-view payload — shared with the /llms.txt and /index.md endpoints (parity).
const rawMarkdown = await buildRawMarkdown();

// Brand marks, inlined instead of loading FontAwesome's ~full stylesheet for 6 icons.
// Official Simple Icons glyphs (MIT, no attribution required) — same geometry as the
// FontAwesome brand icons they replace, just without the render-blocking CDN request.
const SOCIAL_ICON_PATHS = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003',
  dev: 'M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.05 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.3-.28v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.64v1.3zm4.68 5.45c-.17.43-.64.79-1 .79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.67 6.38-1.8 6.68z',
  reddit:
    'M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z',
};
---

<BaseLayout title="adrijshikhar.dev" skyMode="full">
  <aside aria-label="View mode">
    <ViewToggle client:load />
  </aside>
  <div class="machine-view" />

  <div class="human-view min-h-screen px-5 md:px-8">
    <SideRail />

    <!-- Single centred column at the prototype's 46rem. Every other page on the
         site is already single-column (posts max-w-3xl, lists max-w-5xl), so
         this also makes the home page stop being the odd one out. The margins
         it frees are the point: they are where the sky lives, and where the
         corner instruments sit, instead of the sky and the content fighting
         over the same band. -->
    <div class="mx-auto max-w-[46rem]">
      <main id="content" class="content-plane pb-8">

        <!-- Landing view: the hero owns the first screen, vertically centred,
             exactly as the prototype does it (min-height:100dvh, flex, centre).
             100dvh not 100vh so the iOS address bar cannot cause a jump. Content
             below is revealed by scrolling. -->
        <header class="flex min-h-[100dvh] flex-col justify-center pb-24 pt-32">
          <p class="mb-6 flex items-center gap-3 label-data">
            <span class="live inline-block h-[5px] w-[5px] rounded-full bg-accent"></span>
            Bengaluru
          </p>
          <h1 class="display-hero">
            <a href="/" class="no-underline">Adrij<br />Shikhar</a>
          </h1>
          <p class="mt-8 max-w-[36rem] text-[1.15rem] leading-relaxed text-text">
            Senior software engineer at Hevo Data. I move data between systems that were
            never designed to agree, and <em class="not-italic text-heading">write down what
            breaks on the way</em>.
          </p>
          <div class="mt-10 flex items-center gap-6">
            <ul class="flex items-center gap-6" aria-label="Social media">
              {[
                { href: 'https://github.com/adrijshikhar', label: 'GitHub', path: SOCIAL_ICON_PATHS.github },
                { href: 'https://www.linkedin.com/in/adrijshikhar/', label: 'LinkedIn', path: SOCIAL_ICON_PATHS.linkedin },
                { href: 'https://dev.to/adrijshikhar', label: 'DEV', path: SOCIAL_ICON_PATHS.dev },
                { href: 'mailto:adrijshikhar@gmail.com', label: 'Email', path: null },
                { href: 'https://www.reddit.com/user/adrijshikhar', label: 'Reddit', path: SOCIAL_ICON_PATHS.reddit },
              ].map((sLink) => (
                <li class="shrink-0 text-xs">
                  <a class="tap-44 block text-muted no-underline transition-colors duration-[120ms] hover:text-accent"
                     href={sLink.href} target="_blank" rel="noreferrer noopener"
                     aria-label={`${sLink.label} (opens in a new tab)`}>
                    {sLink.path ? (
                      <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d={sLink.path} /></svg>
                    ) : (
                      // No brand mark for email — hand-drawn to match the site's 1px
                      // hairline instrument language (viewfinder brackets, --rule-hi).
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="1.5" />
                        <path d="M3.5 6.5l8.5 7 8.5-7" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
            <a class="tap-44 flex items-center gap-2 text-muted no-underline transition-colors duration-[120ms] hover:text-accent"
               href="/resume/">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4" />
                <path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
              </svg>
              <span class="font-mono text-xs font-medium uppercase tracking-[0.16em]">CV</span>
            </a>
          </div>

          <p class="scroll-cue mt-16" aria-hidden="true">
            <span class="scroll-cue-rail"></span>
            Scroll &mdash; the constellations draw themselves
          </p>
        </header>

        <!-- About -->
        <section id="about" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="channel mb-4"><span class="label-data channel-no">01</span></div>
          <h2 class="display-section mb-8">About</h2>
          <div
            class="prose prose-invert max-w-[35rem] leading-relaxed text-text prose-p:text-text prose-p:leading-relaxed prose-a:text-accent prose-a:underline prose-a:decoration-1 prose-a:underline-offset-[0.2em] prose-strong:text-heading prose-strong:font-medium"
            set:html={marked.parse(about.content)}
          />
        </section>

        <!-- Experience -->
        <section id="experience" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="channel mb-4"><span class="label-data channel-no">02</span></div>
          <h2 class="display-section mb-8">Experience</h2>
          <ul class="group/list border-b-0">
            {experience.meta.entries.slice(0, 2).map((exp: any) => (
              <ExpCard {...exp} />
            ))}
          </ul>
          <div class="mt-10">
            <a class="group atelier-btn" href="/experience/">
              <span>View full work experience</span><span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </section>

        <!-- Projects -->
        <section id="projects" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="channel mb-4"><span class="label-data channel-no">03</span></div>
          <h2 class="display-section mb-8">Projects</h2>
          <ul class="group/list">
            {projects.meta.entries.slice(0, 2).map((proj: any) => (
              <ProjectCard {...proj} contentHtml={marked.parse(projSections[proj.slug] || '') as string} />
            ))}
          </ul>
          <div class="mt-10">
            <a class="group atelier-btn" href="/archive/">
              <span>View full project archive</span><span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </section>

        <!-- Writing -->
        <section id="writing" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="channel mb-4"><span class="label-data channel-no">04</span></div>
          <h2 class="display-section mb-8">Writing</h2>
          {latestPosts.length === 0 ? (
            <p class="border border-border px-5 py-6 font-mono text-sm text-muted">
              <span class="text-accent">$</span> ls ./posts — <span class="text-text">no entries yet.</span>
            </p>
          ) : (
            <ul class="group/list">
              {latestPosts.map((post) => (
                <BlogCard title={post.data.title} date={fmtPostDate(post.data.date)} href={`/blogs/${post.id}/`} />
              ))}
            </ul>
          )}
          <div class="mt-10">
            <a class="group atelier-btn" href="/blogs/">
              <span>View all posts</span><span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </section>

        <!-- Education -->
        <section id="education" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="channel mb-4"><span class="label-data channel-no">05</span></div>
          <h2 class="display-section mb-8">Education</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {education.meta.entries.map((edu: any, i: number) => (
              <li class={`atelier-card group/list-item px-5 py-6 lg:px-6 lg:py-7`}>
                <span class="meta-data">{edu.startDate} — {edu.endDate}</span>
                <h3 class="mt-2 title-entry">{edu.institution}</h3>
                <div class="mt-1 text-sm text-text">
                  {edu.degree}{edu.field && <span class="text-muted"> — {edu.field}</span>}
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Achievements -->
        <section id="achievements" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="channel mb-4"><span class="label-data channel-no">06</span></div>
          <h2 class="display-section mb-8">Achievements</h2>
          <div
            class="prose prose-invert max-w-[35rem] text-text prose-p:text-text prose-li:text-text marker:text-accent prose-a:text-accent prose-a:underline prose-a:decoration-1 prose-a:underline-offset-[0.2em] prose-strong:text-heading"
            set:html={marked.parse(achievements.content)}
          />
        </section>

        <!-- Interests -->
        <section id="interests" class="mb-12 scroll-mt-16 md:mb-16 lg:scroll-mt-24">
          <div class="channel mb-4"><span class="label-data channel-no">07</span></div>
          <h2 class="display-section mb-8">Interests</h2>
          <div
            class="prose prose-invert max-w-[35rem] text-text prose-p:text-text prose-li:text-text marker:text-accent prose-a:text-accent prose-a:underline prose-a:decoration-1 prose-a:underline-offset-[0.2em] prose-strong:text-heading"
            set:html={marked.parse(interests.content)}
          />
        </section>

        {/* The gap above the rule is open sky, not slack. The orbital-mechanics
            game plays over the whole viewport, so the page needs a stretch with
            no prose under it — otherwise every sling is thrown across text.
            Viewport-relative so the room is real on any screen. It sits BEFORE
            the footer: past the last line there is nothing left to look at, so
            the same space there just reads as the page failing to end. */}
        <footer class="mt-[29vh] border-t border-border pt-12 pb-20 md:mt-[33vh] md:pb-24">
          <p class="meta-data">
            <span class="text-accent">&#9656;</span> {STAR_COUNT} named stars at true J2000 positions
            for your location · faint field is representative
          </p>
          <p class="meta-data mt-2">Built with Astro.</p>
        </footer>


      </main>
    </div>
  </div>

  <script define:vars={{ rawMarkdown }}>
    window.__RAW_MARKDOWN__ = rawMarkdown;
  </script>
</BaseLayout>
