---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import matter from 'gray-matter';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
import Section from '../components/Section.astro';
import ExpCard from '../components/ExpCard.tsx';
import ProjectCard from '../components/ProjectCard.tsx';
import BlogCard from '../components/BlogCard.tsx';
import ViewToggle from '../components/ViewToggle.tsx';

function readContent(filename: string) {
  const raw = readFileSync(join(process.cwd(), 'src/content', filename), 'utf-8');
  const { data, content } = matter(raw);
  return { meta: data, content };
}

function splitBySlug(content: string): Record<string, string> {
  const sections: Record<string, string> = {};
  const parts = content.split(/<!--\s*([\w-]+)\s*-->/);
  for (let i = 1; i < parts.length; i += 2) {
    sections[parts[i]] = parts[i + 1]?.trim() || '';
  }
  return sections;
}

const about = readContent('about.md');
const experience = readContent('experience.md');
const projects = readContent('projects.md');
const education = readContent('education.md');
// skills.md removed from rendered sections
const achievements = readContent('achievements.md');
const interests = readContent('interests.md');

const expSections = splitBySlug(experience.content);
const projSections = splitBySlug(projects.content);

const latestPosts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmtPostDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

function formatExpEntry(entry: any, body: string): string {
  return `### ${entry.position} @ ${entry.company} (${entry.startDate} — ${entry.endDate})\n\n${body}`;
}

function formatProjEntry(entry: any, body: string): string {
  const header = entry.link ? `### [${entry.title}](${entry.link}) — ${entry.company}` : `### ${entry.title} — ${entry.company}`;
  return `${header}\n\n${body}`;
}

const rawMarkdown = [
  `# ${about.meta.name}\n\n${about.content}`,
  `\n---\n\n## Experience\n\n${experience.meta.entries.map((e: any) => formatExpEntry(e, expSections[e.slug] || '')).join('\n\n---\n\n')}`,
  `\n---\n\n## Projects\n\n${projects.meta.entries.map((p: any) => formatProjEntry(p, projSections[p.slug] || '')).join('\n\n---\n\n')}`,
  `\n---\n\n## Writing\n\n${latestPosts.map((post) => `- [${post.data.title}](/blogs/${post.id})`).join('\n') || '_No posts yet._'}`,
  `\n---\n\n## Achievements\n\n${achievements.content}`,
  `\n---\n\n## Education\n\n${education.meta.entries.map((e: any) => `### ${e.institution}\n\n${e.degree}${e.field ? ` — ${e.field}` : ''}`).join('\n\n')}`,
  `\n---\n\n## Interests\n\n${interests.content}`,
].join('\n');
---

<BaseLayout title="Adrij Shikhar">
  <div class="pointer-events-none fixed inset-0 z-30 transition-opacity duration-300" id="spotlight"></div>
  <ViewToggle client:load />
  <div class="machine-view" />

  <div class="human-view mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-16 lg:py-0">
    <div class="lg:flex lg:justify-between lg:gap-10">
      <SideNav />

      <main id="content" class="pt-24 lg:w-[58%] lg:py-24">

        <!-- About -->
        <section id="about" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted"><span class="h-2 w-2 rounded-full bg-accent"></span> about</p>
          <div
            class="prose prose-invert prose-sm max-w-none text-text prose-p:text-text prose-p:leading-relaxed prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-strong:text-heading prose-strong:font-medium"
            set:html={marked.parse(about.content)}
          />
        </section>

        <!-- Experience -->
        <section id="experience" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-6 w-screen border-b border-border bg-bg/80 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:border-0 lg:bg-transparent lg:px-0 lg:py-0">
            <h2 class="text-sm font-medium uppercase tracking-widest text-heading lg:sr-only">Experience</h2>
          </div>
          <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted hidden lg:flex"><span class="h-2 w-2 rounded-full bg-accent"></span> experience</p>
          <ul class="group/list border-b-0">
            {experience.meta.entries.slice(0, 1).map((exp: any) => (
              <ExpCard {...exp} contentHtml={marked.parse(expSections[exp.slug] || '') as string} />
            ))}
          </ul>
          <div class="mt-10">
            <a class="group atelier-btn" href="/experience">
              <span>View full work experience</span><span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </section>

        <!-- Projects -->
        <section id="projects" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-6 w-screen border-b border-border bg-bg/80 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:border-0 lg:bg-transparent lg:px-0 lg:py-0">
            <h2 class="text-sm font-medium uppercase tracking-widest text-heading lg:sr-only">Projects</h2>
          </div>
          <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted hidden lg:flex"><span class="h-2 w-2 rounded-full bg-accent"></span> projects</p>
          <ul class="group/list">
            {projects.meta.entries.slice(0, 2).map((proj: any) => (
              <ProjectCard {...proj} contentHtml={marked.parse(projSections[proj.slug] || '') as string} />
            ))}
          </ul>
          <div class="mt-10">
            <a class="group atelier-btn" href="/archive">
              <span>View full project archive</span><span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </section>

        <!-- Writing -->
        <section id="writing" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-6 w-screen border-b border-border bg-bg/80 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:border-0 lg:bg-transparent lg:px-0 lg:py-0">
            <h2 class="text-sm font-medium uppercase tracking-widest text-heading lg:sr-only">Writing</h2>
          </div>
          <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted hidden lg:flex"><span class="h-2 w-2 rounded-full bg-accent"></span> writing</p>
          {latestPosts.length === 0 ? (
            <p class="border border-border px-5 py-6 font-mono text-sm text-muted">
              <span class="text-accent">$</span> ls ./posts — <span class="text-text">no entries yet.</span>
            </p>
          ) : (
            <ul class="group/list">
              {latestPosts.map((post) => (
                <BlogCard title={post.data.title} date={fmtPostDate(post.data.date)} href={`/blogs/${post.id}`} />
              ))}
            </ul>
          )}
          <div class="mt-10">
            <a class="group atelier-btn" href="/blogs">
              <span>View all posts</span><span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </section>

        <!-- Education -->
        <section id="education" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-6 w-screen border-b border-border bg-bg/80 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:border-0 lg:bg-transparent lg:px-0 lg:py-0">
            <h2 class="text-sm font-medium uppercase tracking-widest text-heading lg:sr-only">Education</h2>
          </div>
          <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted hidden lg:flex"><span class="h-2 w-2 rounded-full bg-accent"></span> education</p>
          <ul class="border-t border-border">
            {education.meta.entries.map((edu: any) => (
              <li class="group flex flex-col justify-between gap-1 border-b border-border py-5 transition-colors duration-[120ms] hover:bg-surface md:flex-row md:items-baseline">
                <div class="flex-1">
                  <h3 class="font-heading text-base font-medium tracking-tighter text-heading">{edu.institution}</h3>
                  <div class="mt-0.5 text-sm text-text">
                    {edu.degree}{edu.field && <span class="text-muted"> — {edu.field}</span>}
                  </div>
                </div>
                <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.12em] text-muted">{edu.startDate} — {edu.endDate}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Achievements -->
        <section id="achievements" class="mb-20 scroll-mt-16 md:mb-28 lg:scroll-mt-24">
          <div class="sticky top-0 z-20 -mx-6 mb-6 w-screen border-b border-border bg-bg/80 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:border-0 lg:bg-transparent lg:px-0 lg:py-0">
            <h2 class="text-sm font-medium uppercase tracking-widest text-heading lg:sr-only">Achievements</h2>
          </div>
          <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted hidden lg:flex"><span class="h-2 w-2 rounded-full bg-accent"></span> achievements</p>
          <div
            class="prose prose-invert max-w-none text-text prose-p:text-text prose-li:text-text marker:text-accent prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-strong:text-heading"
            set:html={marked.parse(achievements.content)}
          />
        </section>

        <!-- Interests -->
        <section id="interests" class="mb-12 scroll-mt-16 md:mb-16 lg:scroll-mt-24">
          <p class="mb-5 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted"><span class="h-2 w-2 rounded-full bg-accent"></span> interests</p>
          <div
            class="prose prose-invert max-w-none text-text prose-p:text-text prose-li:text-text marker:text-accent prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-strong:text-heading"
            set:html={marked.parse(interests.content)}
          />
        </section>

        <footer class="mt-8 border-t border-border pt-8">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
            <span class="text-accent">&#9656;</span> Designed in the terminal. Built with Astro.
          </p>
        </footer>


      </main>
    </div>
  </div>

  <script define:vars={{ rawMarkdown }}>
    window.__RAW_MARKDOWN__ = rawMarkdown;
  </script>
  <script>
    const spotlight = document.getElementById('spotlight');

    // Subtle accent-tinted spotlight (low alpha to stay flat).
    // Cache the resolved RGB and refresh only when the theme attribute changes.
    let accentRGB = '251, 99, 27';
    function refreshAccent() {
      const c = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
      const tmp = document.createElement('span');
      tmp.style.color = c;
      document.body.appendChild(tmp);
      const m = getComputedStyle(tmp).color.match(/\d+/g);
      tmp.remove();
      if (m) accentRGB = `${m[0]}, ${m[1]}, ${m[2]}`;
    }
    refreshAccent();
    new MutationObserver(refreshAccent).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    document.addEventListener('mousemove', (e) => {
      if (spotlight && !document.body.classList.contains('machine-mode')) {
        spotlight.style.background = `radial-gradient(560px at ${e.clientX}px ${e.clientY}px, rgba(${accentRGB}, 0.06), transparent 72%)`;
      }
    });

    // Hide spotlight in machine mode
    const modeObserver = new MutationObserver(() => {
      const isMachine = document.body.classList.contains('machine-mode');
      if (spotlight) spotlight.style.opacity = isMachine ? '0' : '1';
    });
    modeObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });

    // Section fade-in on scroll (progressive enhancement — visible by default if observer unsupported)
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if ('IntersectionObserver' in window && !prefersReduced) {
      const sections = document.querySelectorAll('section[id]');
      // Map each section to its index so reveals can stagger in DOM order.
      const sectionIndex = new WeakMap<Element, number>();
      sections.forEach((s, i) => {
        sectionIndex.set(s, i);
        (s as HTMLElement).style.opacity = '0';
        (s as HTMLElement).style.transform = 'translateY(24px)';
        (s as HTMLElement).style.transition =
          'opacity 0.6s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
      });
      const fadeObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const i = sectionIndex.get(el) ?? 0;
              el.style.transitionDelay = `${Math.min(i, 4) * 60}ms`;
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
              fadeObserver.unobserve(el);
            }
          });
        },
        { threshold: 0.1 }
      );
      sections.forEach((s) => fadeObserver.observe(s));
    }
  </script>
</BaseLayout>
