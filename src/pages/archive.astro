---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import matter from 'gray-matter';
import BaseLayout from '../layouts/BaseLayout.astro';

function readContent(filename: string) {
  const raw = readFileSync(join(process.cwd(), 'src/content', filename), 'utf-8');
  const { data, content } = matter(raw);
  return { meta: data, content };
}

function splitBySlug(content: string): Record<string, string> {
  const sections: Record<string, string> = {};
  const parts = content.split(/<!--\s*([\w-]+)\s*-->/);
  for (let i = 1; i < parts.length; i += 2) {
    sections[parts[i]] = parts[i + 1]?.trim() || '';
  }
  return sections;
}

const projects = readContent('projects.md');
const projSections = splitBySlug(projects.content);

// Extract first line of each project description as summary
function getDescription(slug: string): string {
  const content = projSections[slug] || '';
  const firstLine = content.split('\n').find((l: string) => l.trim() && !l.startsWith('-') && !l.startsWith('#'));
  return firstLine?.trim() || '';
}
---

<BaseLayout title="All Projects | Adrij Shikhar">
  <div class="pointer-events-none fixed inset-0 z-30" id="spotlight"></div>
  <main class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24">
    <a class="group mb-2 inline-flex items-center font-semibold leading-tight text-accent" href="/">
      <span class="mr-1 transition-transform group-hover:-translate-x-1">&larr;</span>
      <span>Adrij Shikhar</span>
    </a>
    <h1 class="text-4xl font-bold tracking-tight text-slate-lightest sm:text-5xl">All Projects</h1>

    <table class="mt-12 w-full border-collapse text-left">
      <thead class="sticky top-0 z-10 border-b border-navy-lighter/50 bg-navy/75 px-6 py-5 backdrop-blur">
        <tr>
          <th class="py-4 pr-8 text-sm font-semibold text-slate-lightest">Year</th>
          <th class="py-4 pr-8 text-sm font-semibold text-slate-lightest">Project</th>
          <th class="hidden py-4 pr-8 text-sm font-semibold text-slate-lightest lg:table-cell">Description</th>
          <th class="hidden py-4 pr-8 text-sm font-semibold text-slate-lightest sm:table-cell">Built with</th>
          <th class="py-4 text-sm font-semibold text-slate-lightest">Link</th>
        </tr>
      </thead>
      <tbody>
        {projects.meta.entries.map((proj: any) => (
          <tr class="border-b border-navy-lighter/30 transition-colors hover:bg-navy-light/30">
            <td class="py-4 pr-8 align-top text-sm text-slate/60">{proj.year}</td>
            <td class="py-4 pr-8 align-top font-medium text-slate-lightest">{proj.title}</td>
            <td class="hidden py-4 pr-8 align-top text-sm text-slate/80 lg:table-cell max-w-xs">{getDescription(proj.slug)}</td>
            <td class="hidden py-4 pr-8 align-top sm:table-cell">
              <div class="flex flex-wrap gap-1.5">
                {(proj.builtWith || []).map((tech: string) => (
                  <span class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium leading-5 text-accent">{tech}</span>
                ))}
              </div>
            </td>
            <td class="py-4 align-top text-sm">
              {proj.link ? (
                <a href={proj.link} target="_blank" rel="noreferrer noopener" class="inline-flex items-center text-slate/80 hover:text-accent transition-colors">
                  <span class="truncate max-w-[180px]">{proj.link.replace('https://github.com/', '')}</span>
                  <span class="ml-1 text-xs">&#8599;</span>
                </a>
              ) : <span class="text-slate/30">—</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </main>
  <script>
    const spotlight = document.getElementById('spotlight');
    document.addEventListener('mousemove', (e) => {
      if (spotlight) {
        spotlight.style.background = `radial-gradient(600px at ${e.clientX}px ${e.clientY}px, rgba(29, 78, 216, 0.15), transparent 80%)`;
      }
    });
  </script>
</BaseLayout>
