---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const canonical = post.data.canonicalUrl ?? new URL(`/blogs/${post.id}/`, Astro.site).href;
---

<BaseLayout
  title={`${post.data.title} | adrijshikhar.dev`}
  canonical={canonical}
  description={post.data.description}
  ogType="article"
  publishedAt={post.data.date}
>
  <main id="content" class="mx-auto min-h-screen max-w-5xl px-6 py-16 md:px-12 md:py-24">
   <div class="reading-plane mx-auto max-w-3xl px-6 py-10 md:px-10">
    <a href="/blogs/" class="group link-back">
      <span class="mr-2 transition-transform duration-[120ms] group-hover:-translate-x-1">&larr;</span>
      <span>all posts</span>
    </a>

    {post.data.cover && (
      <img
        src={post.data.cover}
        alt={post.data.title}
        class="mt-8 aspect-[2/1] w-full rounded-[10px] border border-slate-700 object-cover shadow-[none]"
        loading="eager"
      />
    )}

    <header class={`border-b border-slate-700 pb-8 ${post.data.cover ? 'mt-8' : 'mt-10'}`}>
      <h1 class="font-heading text-3xl font-semibold leading-[1.08] tracking-tightest text-slate-100 sm:text-4xl">{post.data.title}</h1>
      {post.data.description && (
        <p class="mt-4 text-lg leading-relaxed text-slate-400">{post.data.description}</p>
      )}
      <p class="label-data mt-5">{fmt(post.data.date)}</p>
    </header>

    <article
      class="prose prose-invert mt-10 max-w-none text-slate-300
        prose-headings:font-heading prose-headings:tracking-tighter prose-headings:text-slate-100
        prose-p:text-slate-300 prose-p:leading-relaxed prose-li:text-slate-300 marker:text-blue-400
        prose-a:text-blue-400 prose-a:underline prose-a:decoration-1 prose-a:underline-offset-[0.2em]
        prose-strong:text-slate-100 prose-strong:font-medium
        prose-code:rounded-none prose-code:border prose-code:border-slate-700 prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-[0.85em] prose-code:text-slate-100 prose-code:before:content-none prose-code:after:content-none
        prose-pre:rounded-none prose-pre:border prose-pre:border-slate-700 prose-pre:bg-slate-800
        prose-blockquote:border-l-2 prose-blockquote:border-blue-400 prose-blockquote:text-slate-400 prose-blockquote:not-italic
        prose-hr:border-slate-700 prose-img:rounded-none prose-img:border prose-img:border-slate-700"
    >
      <Content />
    </article>
   </div>
  </main>
</BaseLayout>
