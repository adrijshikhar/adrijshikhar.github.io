---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const canonical = post.data.canonicalUrl ?? new URL(`/blogs/${post.id}/`, Astro.site).href;
---

<BaseLayout title={`${post.data.title} | adrijshikhar.dev`} canonical={canonical}>
  <main class="mx-auto min-h-screen max-w-5xl px-6 py-16 md:px-12 md:py-24">
   <div class="mx-auto max-w-3xl">
    <a href="/blogs/" class="group link-back">
      <span class="mr-2 transition-transform duration-[120ms] group-hover:-translate-x-1">&larr;</span>
      <span>all posts</span>
    </a>

    {post.data.cover && (
      <img
        src={post.data.cover}
        alt={post.data.title}
        class="mt-8 aspect-[2/1] w-full rounded-[10px] border border-border object-cover shadow-[var(--card-shadow)]"
        loading="eager"
      />
    )}

    <header class={`border-b border-border pb-8 ${post.data.cover ? 'mt-8' : 'mt-10'}`}>
      <h1 class="font-heading text-3xl font-semibold leading-[1.08] tracking-tightest text-heading sm:text-4xl">{post.data.title}</h1>
      {post.data.description && (
        <p class="mt-4 text-lg leading-relaxed text-muted">{post.data.description}</p>
      )}
      <p class="mt-5 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-muted"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span> {fmt(post.data.date)}</p>
    </header>

    <article
      class="prose prose-invert mt-10 max-w-none
        prose-headings:font-heading prose-headings:tracking-tighter prose-headings:text-heading
        prose-p:text-text prose-p:leading-relaxed prose-li:text-text marker:text-accent
        prose-a:text-accent prose-a:no-underline hover:prose-a:underline
        prose-strong:text-heading prose-strong:font-medium
        prose-code:rounded-none prose-code:border prose-code:border-border prose-code:bg-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-[0.85em] prose-code:text-heading prose-code:before:content-none prose-code:after:content-none
        prose-pre:rounded-none prose-pre:border prose-pre:border-border prose-pre:bg-surface
        prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:text-muted prose-blockquote:not-italic
        prose-hr:border-border prose-img:rounded-none prose-img:border prose-img:border-border"
    >
      <Content />
    </article>
   </div>
  </main>
</BaseLayout>
