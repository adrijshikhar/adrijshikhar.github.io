---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';

function readContent(filename: string) {
  const raw = readFileSync(join(process.cwd(), 'src/content', filename), 'utf-8');
  const { data, content } = matter(raw);
  return { meta: data, content };
}

function splitBySlug(content: string): Record<string, string> {
  const sections: Record<string, string> = {};
  const parts = content.split(/<!--\s*([\w-]+)\s*-->/);
  for (let i = 1; i < parts.length; i += 2) {
    sections[parts[i]] = parts[i + 1]?.trim() || '';
  }
  return sections;
}

const about = readContent('about.md');
const experience = readContent('experience.md');
const education = readContent('education.md');
const skills = readContent('skills.md');
const achievements = readContent('achievements.md');
const expSections = splitBySlug(experience.content);

const proseClass =
  'prose prose-invert prose-sm max-w-none text-foreground prose-p:text-foreground prose-li:text-foreground ' +
  'prose-li:my-0.5 marker:text-primary prose-headings:text-foreground prose-headings:text-sm ' +
  'prose-headings:font-semibold prose-headings:tracking-tighter prose-a:text-primary ' +
  'prose-a:underline prose-a:decoration-1 prose-a:underline-offset-[0.2em] prose-strong:text-foreground prose-strong:font-medium';
---

<BaseLayout title="Resume | adrijshikhar.dev">
  <main id="content" class="reading-plane mx-auto min-h-screen max-w-3xl px-6 py-16 md:px-12 md:py-24">
    <a href="/" class="group text-sm text-muted-foreground hover:underline">
      <span class="mr-2 transition-transform duration-[120ms] group-hover:-translate-x-1">&larr;</span>
      <span>adrij_shikhar</span>
    </a>

    <header class="mt-10 flex flex-col gap-6 border-b border-border pb-10 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-4xl font-bold tracking-tight">{about.meta.name ?? 'Adrij Shikhar'}</h1>
        <p class="mt-2 font-heading text-base font-medium tracking-tighter text-foreground">Senior Software Engineer</p>
      </div>
      <a
        href="/assets/resume.pdf"
        download="Adrij Shikhar Resume.pdf"
        class="group inline-flex shrink-0 items-center gap-2 border border-border px-4 py-2.5 font-mono text-xs uppercase tracking-[0.14em] text-foreground no-underline transition-colors duration-[120ms] hover:border-primary hover:text-primary"
      >
        <span class="text-primary">&#9662;</span> Download PDF
      </a>
    </header>

    <!-- Experience -->
    <section class="mt-12">
      <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground mb-6">experience</p>
      <ul class="border-t border-border">
        {experience.meta.entries.map((exp: any) => (
          <li class="border-b border-border py-6">
            <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
              <h2 class="font-heading text-base font-medium tracking-tighter text-foreground">
                {exp.position} <span class="mx-1 text-muted-foreground">/</span> {exp.company}
              </h2>
              <span class="shrink-0 font-mono text-xs uppercase tracking-wider text-muted-foreground">{exp.startDate} — {exp.endDate}</span>
            </div>
            {exp.location && <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground mt-0.5">{exp.location}</p>}
            {expSections[exp.slug] && (
              <div class={`mt-3 ${proseClass}`} set:html={marked.parse(expSections[exp.slug])} />
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- Education -->
    <section class="mt-12">
      <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground mb-6">education</p>
      <ul class="border-t border-border">
        {education.meta.entries.map((edu: any) => (
          <li class="flex flex-col gap-1 border-b border-border py-5 md:flex-row md:items-baseline md:justify-between">
            <div>
              <h3 class="font-heading text-base font-medium tracking-tighter text-foreground">{edu.institution}</h3>
              <p class="mt-0.5 text-sm text-foreground">{edu.degree}{edu.field && <span class="text-muted-foreground"> — {edu.field}</span>}</p>
            </div>
            <span class="shrink-0 font-mono text-xs uppercase tracking-wider text-muted-foreground">{edu.startDate} — {edu.endDate}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Skills -->
    <section class="mt-12">
      <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground mb-6">skills</p>
      <div class={proseClass} set:html={marked.parse(skills.content)} />
    </section>

    <!-- Achievements -->
    <section class="mt-12">
      <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground mb-6">achievements</p>
      <div class={proseClass} set:html={marked.parse(achievements.content)} />
    </section>
  </main>
</BaseLayout>
