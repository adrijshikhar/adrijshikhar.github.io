---
import { marked } from 'marked';
import ProjectCard from './ProjectCard.tsx';

interface Props {
  entries: Array<Record<string, any>>;
  sections: Record<string, string>;
}

const { entries, sections } = Astro.props;
---

<ul class="columns-1 gap-10 sm:columns-2">
  {entries.map((project) => (
    <li class="mb-2 inline-block w-full align-top break-inside-avoid">
      <ProjectCard {...project} contentHtml={marked.parse(sections[project.slug] || '') as string} />
    </li>
  ))}
</ul>
