---
/**
 * Telescope bar — the home page's in-page navigation, moved out of the old
 * left rail so the page can run as a single centred column and hand the
 * margins to the sky.
 *
 * Framed like an eyepiece: a hairline top and bottom with the section list
 * running between them, so the bar reads as the instrument's frame rather
 * than as a website chrome strip sitting on top of it.
 *
 * Keeps the scroll-spy contract the left rail had: each link carries
 * `data-section`, and `.nav-link` / `.nav-indicator` / `.nav-text` are the
 * hooks the IntersectionObserver below drives. Sections without a nav entry
 * (e.g. #interests) are deliberately not observed — otherwise they would
 * intersect and deactivate every link.
 */
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'education', label: 'Education' },
  { id: 'achievements', label: 'Achievements' },
];
---

<header
  class="sticky top-0 z-[1000] -mx-5 mb-14 border-b border-[rgb(var(--border)/0.5)] bg-[color-mix(in_srgb,var(--bg)_86%,transparent)] px-5 backdrop-blur-xl md:-mx-8 md:px-8 md:mb-20"
>
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-6 md:h-16">
    <a
      href="/"
      class="shrink-0 font-mono text-xs font-medium uppercase tracking-[0.16em] text-heading no-underline transition-colors hover:text-accent"
    >
      <span class="text-accent">&#9656;</span> adrijshikhar
    </a>

    <!-- Section links. Hidden below md — the sections already carry their own
         sticky headers on small screens, so a cramped scrolling bar would be
         a second, worse navigation for the same job. -->
    <nav class="nav hidden md:block" aria-label="In-page jump links">
      <ul class="flex items-center gap-1">
        {sections.map((s) => (
          <li>
            <a class="group nav-link block px-2.5 py-2" href={`#${s.id}`} data-section={s.id}>
              <span class="nav-text font-mono text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-muted transition-colors group-hover:text-heading group-focus-visible:text-heading">
                {s.label}
              </span>
              <!-- Underline doubles as the active indicator: it is the same
                   element the old rail animated, just rotated to sit under the
                   label instead of beside it. -->
              <span class="nav-indicator mt-1 block h-px w-0 bg-accent transition-all duration-[160ms] ease-out group-hover:w-full"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Reserves the fixed ModeToggle's corner so the last link never slides
         under it. Matches the toggle's 44px box plus its 20/24px inset. -->
    <div class="w-11 shrink-0 md:w-16" aria-hidden="true"></div>
  </div>
</header>

<script>
  const navLinks = document.querySelectorAll('.nav-link');
  const navIds = new Set([...navLinks].map((l) => l.getAttribute('data-section')));
  const sectionEls = [...document.querySelectorAll('section[id]')].filter((s) => navIds.has(s.id));

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          const isActive = link.getAttribute('data-section') === entry.target.id;
          const indicator = link.querySelector('.nav-indicator');
          const text = link.querySelector('.nav-text');
          indicator?.classList.toggle('w-full', isActive);
          indicator?.classList.toggle('w-0', !isActive);
          text?.classList.toggle('text-heading', isActive);
          text?.classList.toggle('text-muted', !isActive);
        });
      });
    },
    { rootMargin: '-40% 0px -60% 0px' },
  );
  sectionEls.forEach((s) => observer.observe(s));
</script>
