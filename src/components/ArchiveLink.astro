---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-md border bg-card px-4 py-2 text-sm font-medium text-heading transition-colors hover:border-ring hover:text-primary focus-visible:border-ring focus-visible:text-primary"
>
  <slot />
</a>
