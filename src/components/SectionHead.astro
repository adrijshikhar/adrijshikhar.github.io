---
interface Props {
  index: number;
  title: string;
}
const { title } = Astro.props;
---

<div class="mb-7 flex items-center gap-1.5">
  <!-- accent rectangle hugging the first letter — same height as the heading text -->
  <span class="bh-index relative inline-flex shrink-0 items-center bg-accent px-2 font-bold leading-none text-accent-contrast" aria-hidden="true">
    <span class="text-3xl md:text-4xl">{title.charAt(0).toUpperCase()}</span>
    <span class="absolute -right-1.5 -top-1.5 h-2.5 w-2.5 rounded-full bg-[#111111]"></span>
  </span>
  <!-- first letter lives in the box; the heading continues with the rest of the word -->
  <h2 class="-ml-1 text-3xl font-bold leading-none tracking-tightest text-heading md:text-4xl">
    {title.slice(1)}
  </h2>
  <span aria-hidden="true" class="ml-4 h-[3px] flex-1 bg-ink"></span>
</div>
