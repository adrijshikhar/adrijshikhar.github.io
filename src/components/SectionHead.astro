---
interface Props {
  index: number;
  title: string;
}
const { title } = Astro.props;
---

<div class="mb-7 flex items-center gap-4">
  <!-- geometric accent square marker (no number) -->
  <span class="bh-index relative inline-block h-12 w-12 shrink-0 bg-accent md:h-14 md:w-14">
    <span aria-hidden="true" class="absolute -right-2 -top-2 h-3 w-3 rounded-full bg-ink"></span>
  </span>
  <h2 class="text-3xl font-bold tracking-tightest text-heading md:text-4xl">
    {title}
  </h2>
  <span aria-hidden="true" class="h-[3px] flex-1 bg-ink"></span>
</div>
