---
interface Props {
  index: number;
  title: string;
}
const { title } = Astro.props;
---

<div class="mb-7 flex items-center gap-1.5">
  <!-- geometric accent square marker — first letter of the heading -->
  <span class="bh-index relative inline-flex h-12 w-12 shrink-0 items-center justify-center bg-accent font-bold leading-none text-accent-contrast md:h-14 md:w-14" aria-hidden="true">
    <span class="text-3xl md:text-4xl">{title.charAt(0).toUpperCase()}</span>
    <span class="absolute -right-2 -top-2 h-3 w-3 rounded-full bg-ink"></span>
  </span>
  <!-- first letter lives in the square; the heading continues with the rest of the word -->
  <h2 class="-ml-1 text-3xl font-bold tracking-tightest text-heading md:text-4xl">
    {title.slice(1)}
  </h2>
  <span aria-hidden="true" class="ml-4 h-[3px] flex-1 bg-ink"></span>
</div>
