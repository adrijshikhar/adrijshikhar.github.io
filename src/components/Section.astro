---
interface Props {
  id: string;
  title: string;
  index: number;
}

const { id, title, index } = Astro.props;
const idx = String(index).padStart(2, '0');
---

<section class="py-20 scroll-mt-24" id={id}>
  <h2 class="mb-10 flex items-baseline gap-4">
    <span class="sec-index">{idx}</span>
    <span class="font-heading text-2xl font-semibold tracking-tighter text-heading">{title}</span>
    <span class="h-px flex-1 self-center bg-border"></span>
  </h2>
  <slot />
</section>
