---
interface Props {
  id: string;
  title: string;
  index: number;
}

const { id, title, index } = Astro.props;
---

<section class="py-24 scroll-mt-24" id={id}>
  <h2 class="mb-10 flex items-center gap-4 text-2xl font-bold tracking-tightest text-heading">
    <span class="bh-index bg-accent px-1.5 text-xl text-accent-contrast">0{index}</span>
    {title}
    <span class="h-[3px] flex-1 bg-ink"></span>
  </h2>
  <slot />
</section>
