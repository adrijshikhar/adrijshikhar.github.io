---
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'education', label: 'Education' },
  { id: 'achievements', label: 'Achievements' },
];
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[42%] lg:flex-col lg:justify-between lg:py-24">
  <div>
    <p class="mb-4 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.2em] text-muted"><span class="h-2 w-2 rounded-full bg-accent"></span> portfolio.exe</p>
    <h1 class="font-heading text-[2.6rem] font-semibold leading-[0.95] tracking-tightest text-heading sm:text-[2.9rem]">
      <a href="/" class="aurora-text no-underline">Adrij Shikhar</a>
    </h1>
    <h2 class="mt-3 font-heading text-base font-medium tracking-tighter text-heading sm:text-lg">
      Senior Software Engineer
    </h2>
    <p class="mt-4 max-w-xs text-sm leading-relaxed text-text">
      I build scalable data platforms and craft software that pushes boundaries.
    </p>
    <nav class="nav hidden lg:block" aria-label="In-page jump links">
      <ul class="mt-16 w-max">
        {sections.map((s, i) => (
          <li>
            <a
              class="group nav-link flex items-center py-3"
              href={`#${s.id}`}
              data-section={s.id}
            >
              <span class="nav-indicator mr-4 h-px w-6 bg-muted transition-all duration-[120ms] ease-out group-hover:w-12 group-hover:bg-accent group-focus-visible:w-12 group-focus-visible:bg-accent"></span>
              <span class="nav-text font-mono text-xs font-medium uppercase tracking-[0.16em] text-muted transition-colors group-hover:text-heading group-focus-visible:text-heading">
                {s.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="ml-1 mt-8 flex items-center justify-between">
    <ul class="flex items-center gap-5" aria-label="Social media">
      {[
        { icon: 'fab fa-github', url: 'https://github.com/adrijshikhar/', label: 'GitHub' },
        { icon: 'fab fa-linkedin-in', url: 'https://www.linkedin.com/in/adrij-shikhar', label: 'LinkedIn' },
        { icon: 'fab fa-dev', url: 'https://dev.to/adrijshikhar', label: 'DEV' },
        { icon: 'fa fa-envelope', url: 'mailto:ashikhar@ee.iitr.ac.in', label: 'Email' },
        { icon: 'fab fa-reddit', url: 'https://www.reddit.com/user/nemesis0009', label: 'Reddit' },
      ].map((s) => (
        <li class="shrink-0 text-xs">
          <a
            class="block text-muted no-underline transition-colors duration-[120ms] hover:text-accent"
            href={s.url}
            target="_blank"
            rel="noreferrer noopener"
            title={s.label}
            aria-label={`${s.label} (opens in new tab)`}
          >
            <i class={`${s.icon} text-xl`}></i>
          </a>
        </li>
      ))}
    </ul>
    <a
      class="mr-6 text-muted no-underline transition-colors duration-[120ms] hover:text-accent"
      href="/assets/resume.pdf"
      download="Adrij Shikhar Resume.pdf"
      title="Download Resume"
      aria-label="Download Resume"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12m0 0l-4-4m4 4l4-4" />
        <path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
      </svg>
    </a>
  </div>
</header>

<script>
  // Scroll-spy for desktop nav
  const navLinks = document.querySelectorAll('.nav-link');
  const sectionEls = document.querySelectorAll('section[id]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            const isActive = link.getAttribute('data-section') === entry.target.id;
            const indicator = link.querySelector('.nav-indicator');
            const text = link.querySelector('.nav-text');
            const index = link.querySelector('.nav-index');
            if (isActive) {
              indicator?.classList.add('w-12');
              indicator?.classList.remove('w-6', 'bg-muted');
              (indicator as HTMLElement | null)?.style.setProperty('background-color', 'var(--accent)');
              text?.classList.add('text-heading');
              text?.classList.remove('text-muted');
              (index as HTMLElement | null)?.style.setProperty('color', 'var(--accent)');
            } else {
              indicator?.classList.remove('w-12');
              indicator?.classList.add('w-6', 'bg-muted');
              (indicator as HTMLElement | null)?.style.removeProperty('background-color');
              text?.classList.remove('text-heading');
              text?.classList.add('text-muted');
              (index as HTMLElement | null)?.style.removeProperty('color');
            }
          });
        }
      });
    },
    { rootMargin: '-40% 0px -60% 0px' }
  );
  sectionEls.forEach((s) => observer.observe(s));
</script>
