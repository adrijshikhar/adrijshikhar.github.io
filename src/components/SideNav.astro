---
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'education', label: 'Education' },
  { id: 'achievements', label: 'Achievements' },
];
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[36%] lg:flex-col lg:justify-between lg:py-20">
  <div>
    <!-- Identity composition: name in an ink block + primary shapes -->
    <div class="relative">
      <!-- yellow square accent -->
      <span aria-hidden="true" class="absolute -left-2 -top-4 h-7 w-7 bg-block-2 border-[3px] border-ink hidden sm:block"></span>
      <!-- accent circle -->
      <span aria-hidden="true" class="absolute -right-3 top-10 h-12 w-12 rounded-full bg-accent border-[3px] border-ink hidden sm:block"></span>

      <div class="relative inline-block bg-ink px-4 py-3 border-[3px] border-ink">
        <h1 class="text-[2.6rem] font-bold leading-[0.92] tracking-tightest text-bg sm:text-[3rem]">
          <a href="/" class="text-inherit hover:text-block-2">Adrij<br />Shikhar</a>
        </h1>
      </div>
    </div>

    <h2 class="mt-6 inline-block bg-accent px-2 py-1 text-base font-bold uppercase tracking-tight text-accent-contrast sm:text-lg">
      Senior Software Engineer
    </h2>
    <p class="mt-5 max-w-xs text-[0.95rem] leading-snug text-text">
      I build scalable data platforms and craft software that pushes boundaries.
    </p>

    <nav class="nav hidden lg:block" aria-label="In-page jump links">
      <ul class="mt-14 w-max">
        {sections.map((s, i) => (
          <li>
            <a
              class="group flex items-center gap-4 py-2.5 nav-link"
              href={`#${s.id}`}
              data-section={s.id}
            >
              <span class="nav-indicator flex h-7 w-7 shrink-0 items-center justify-center border-[3px] border-ink bg-bg font-mono text-xs font-bold text-ink transition-all duration-150 group-hover:bg-accent group-hover:text-accent-contrast group-focus-visible:bg-accent group-focus-visible:text-accent-contrast">{s.label.charAt(0).toUpperCase()}</span>
              <span class="nav-text bh-label text-muted transition-colors group-hover:text-ink group-focus-visible:text-ink">
                {s.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="mt-10 flex items-center justify-between border-t-[3px] border-ink pt-5">
    <ul class="flex items-center gap-4" aria-label="Social media">
      {[
        { icon: 'fab fa-github', url: 'https://github.com/adrijshikhar/', label: 'GitHub' },
        { icon: 'fab fa-linkedin-in', url: 'https://www.linkedin.com/in/adrij-shikhar', label: 'LinkedIn' },
        { icon: 'fab fa-dev', url: 'https://dev.to/adrijshikhar', label: 'DEV' },
        { icon: 'fa fa-envelope', url: 'mailto:ashikhar@ee.iitr.ac.in', label: 'Email' },
        { icon: 'fab fa-reddit', url: 'https://www.reddit.com/user/nemesis0009', label: 'Reddit' },
      ].map((s) => (
        <li class="shrink-0 text-xs">
          <a
            class="flex h-9 w-9 items-center justify-center border-2 border-ink bg-surface text-ink transition-colors hover:bg-ink hover:text-bg"
            href={s.url}
            target="_blank"
            rel="noreferrer noopener"
            title={s.label}
            aria-label={`${s.label} (opens in new tab)`}
          >
            <i class={`${s.icon} text-base`}></i>
          </a>
        </li>
      ))}
    </ul>
    <a
      class="flex items-center gap-1.5 border-2 border-ink bg-accent px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wide text-accent-contrast transition-transform hover:-translate-y-0.5"
      href="/assets/resume.pdf"
      download="Adrij Shikhar Resume.pdf"
      title="Download Resume"
      aria-label="Download Resume"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12m0 0l-4-4m4 4l4-4" />
        <path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
      </svg>
      CV
    </a>
  </div>
</header>

<script>
  // Scroll-spy for desktop nav
  const navLinks = document.querySelectorAll('.nav-link');
  const sectionEls = document.querySelectorAll('section[id]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            const isActive = link.getAttribute('data-section') === entry.target.id;
            const indicator = link.querySelector('.nav-indicator');
            const text = link.querySelector('.nav-text');
            if (isActive) {
              indicator?.classList.add('bg-accent', 'text-accent-contrast');
              indicator?.classList.remove('bg-bg', 'text-ink');
              text?.classList.add('text-ink');
              text?.classList.remove('text-muted');
            } else {
              indicator?.classList.remove('bg-accent', 'text-accent-contrast');
              indicator?.classList.add('bg-bg', 'text-ink');
              text?.classList.remove('text-ink');
              text?.classList.add('text-muted');
            }
          });
        }
      });
    },
    { rootMargin: '-40% 0px -60% 0px' }
  );
  sectionEls.forEach((s) => observer.observe(s));
</script>
