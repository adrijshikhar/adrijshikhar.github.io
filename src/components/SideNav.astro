---
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'education', label: 'Education' },
  { id: 'achievements', label: 'Achievements' },
];
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:py-24">
  <div>
    <h1 class="text-[2.5rem] font-bold tracking-tight text-slate-200 leading-none sm:text-[2.75rem]">
      <a href="/" class="text-inherit hover:text-accent">Adrij Shikhar</a>
    </h1>
    <h2 class="mt-3 text-base font-medium tracking-tight text-slate-200 sm:text-lg">
      Senior Software Engineer
    </h2>
    <p class="mt-4 max-w-xs text-sm leading-normal text-slate-400">
      I build scalable data platforms and craft software that pushes boundaries.
    </p>
    <nav class="nav hidden lg:block" aria-label="In-page jump links">
      <ul class="mt-16 w-max">
        {sections.map((s) => (
          <li>
            <a
              class="group flex items-center py-3 nav-link"
              href={`#${s.id}`}
              data-section={s.id}
            >
              <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-slate-200 group-focus-visible:w-16 group-focus-visible:bg-slate-200"></span>
              <span class="nav-text text-xs font-bold uppercase tracking-widest text-slate-400 group-hover:text-slate-200 group-focus-visible:text-slate-200">
                {s.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="ml-1 mt-8 flex items-center justify-between">
    <ul class="flex items-center gap-5" aria-label="Social media">
      {[
        { icon: 'fab fa-github', url: 'https://github.com/adrijshikhar/', label: 'GitHub' },
        { icon: 'fab fa-linkedin-in', url: 'https://www.linkedin.com/in/adrij-shikhar', label: 'LinkedIn' },
        { icon: 'fab fa-dev', url: 'https://dev.to/adrijshikhar', label: 'DEV' },
        { icon: 'fa fa-envelope', url: 'mailto:ashikhar@ee.iitr.ac.in', label: 'Email' },
        { icon: 'fab fa-reddit', url: 'https://www.reddit.com/user/nemesis0009', label: 'Reddit' },
      ].map((s) => (
        <li class="text-xs shrink-0">
          <a
            class="block text-slate-400 hover:text-slate-200 transition-colors"
            href={s.url}
            target="_blank"
            rel="noreferrer noopener"
            title={s.label}
            aria-label={`${s.label} (opens in new tab)`}
          >
            <i class={`${s.icon} text-xl`}></i>
          </a>
        </li>
      ))}
    </ul>
    <a
      class="text-slate-400 hover:text-accent transition-colors mr-6"
      href="/assets/resume.pdf"
      download="Adrij Shikhar Resume.pdf"
      title="Download Resume"
      aria-label="Download Resume"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12m0 0l-4-4m4 4l4-4" />
        <path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
      </svg>
    </a>
  </div>
</header>

<script>
  // Scroll-spy for desktop nav
  const navLinks = document.querySelectorAll('.nav-link');
  const sectionEls = document.querySelectorAll('section[id]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            const isActive = link.getAttribute('data-section') === entry.target.id;
            const indicator = link.querySelector('.nav-indicator');
            const text = link.querySelector('.nav-text');
            if (isActive) {
              indicator?.classList.add('w-16', 'bg-slate-lightest');
              indicator?.classList.remove('w-8');
              text?.classList.add('text-slate-200');
            } else {
              indicator?.classList.remove('w-16', 'bg-slate-lightest');
              indicator?.classList.add('w-8');
              text?.classList.remove('text-slate-200');
            }
          });
        }
      });
    },
    { rootMargin: '-40% 0px -60% 0px' }
  );
  sectionEls.forEach((s) => observer.observe(s));
</script>
