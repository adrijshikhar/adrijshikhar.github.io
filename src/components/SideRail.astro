---
/**
 * The EVF readout — in-page navigation rendered as a mirrorless viewfinder's
 * live info cluster, not a lens-barrel focus scale. Section labels step past a
 * constant vertical position as you scroll, the way a focal-length readout
 * advances past its index mark; the active one is held bright and wrapped in
 * amber brackets, neighbours dimmed. Beside it, a hairline track fills
 * continuously with real position through the whole document: two separate
 * readouts, exactly like a real EVF's discrete-value cluster next to its
 * always-live zoom/battery meter.
 *
 * Keeps the scroll-spy contract intact: `data-section`, `.nav-link`, same
 * rootMargin. Motion is transform/opacity only — the stepping is driven by
 * IntersectionObserver (no scroll listener); the continuous track by a
 * scroll-driven CSS animation (`animation-timeline: scroll(root)`), which
 * degrades to hidden where unsupported rather than showing a static — and
 * therefore meaningless — bar.
 */
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'education', label: 'Education' },
  { id: 'achievements', label: 'Achievements' },
];
---

<nav class="side-rail" aria-label="In-page jump links">
  <div class="rail-progress" aria-hidden="true"><span class="rail-progress-fill"></span></div>

  <div class="rail-window">
    <ul class="rail-stack">
      {sections.map((s, i) => (
        <li>
          <a class="nav-link" href={`#${s.id}`} data-section={s.id}>
            <span class="rail-bracket" aria-hidden="true">[</span>
            <span class="rail-no">{String(i + 1).padStart(2, '0')}</span>
            <span class="nav-text">{s.label}</span>
            <span class="rail-bracket" aria-hidden="true">]</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .side-rail {
    position: fixed;
    left: 2.25rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    display: none;
    align-items: center;
    gap: 0.9rem;
  }
  /* Only where there is real margin to live in. Below this the content column
     fills the frame and a fixed rail would sit on top of it. */
  @media (min-width: 1180px) {
    .side-rail { display: flex; }
  }

  /* ── Continuous track: real position through the whole document, not just
     which section. A scroll-driven animation scales the fill from 0 to 1
     across the full page scroll range — no scroll listener, no JS. Where
     unsupported, hidden rather than shown static: a frozen bar would be a
     mark that carries no information, which is worse than no mark. */
  .rail-progress {
    position: relative;
    width: 1px;
    height: 9rem;
    background: var(--rule);
    flex: none;
  }
  .rail-progress-fill {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 100%;
    background: var(--accent);
    opacity: 0.9;
    transform-origin: top;
    transform: scaleY(0);
    animation: rail-progress-fill linear;
    animation-timeline: scroll(root);
  }
  @keyframes rail-progress-fill {
    to { transform: scaleY(1); }
  }
  @supports not (animation-timeline: scroll(root)) {
    .rail-progress { display: none; }
  }

  /* ── Windowed readout: three graduations tall, so the active label centres
     in the window with one dimmed neighbour above and below — the same
     silhouette as a focal-length dial's visible run. */
  .rail-window {
    position: relative;
    overflow: hidden;
    --item-h: 2.3rem;
    height: calc(var(--item-h) * 3);
  }

  .rail-stack {
    margin: 0;
    padding: 0;
    list-style: none;
    --i: 0;
    /* Centres the active (index --i) item in the window: shift the whole
       stack up by one item-height per step, then re-add one item-height so
       index 0 sits centred rather than flush with the window's top edge. */
    transform: translateY(calc(var(--item-h) * (1 - var(--i))));
    transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .rail-stack li {
    height: var(--item-h);
  }

  .nav-link {
    display: flex;
    height: 100%;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    opacity: 0.4;
    transition: opacity 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .nav-link:hover,
  .nav-link:focus-visible { opacity: 0.75; }
  .nav-link.is-at { opacity: 1; }

  .rail-bracket {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .nav-link.is-at .rail-bracket { opacity: 1; }

  .rail-no {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    opacity: 0.5;
    width: 1.1rem;
    transition: color 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .nav-link.is-at .rail-no { color: var(--accent); opacity: 1; }

  .nav-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .nav-link:hover .nav-text,
  .nav-link:focus-visible .nav-text,
  .nav-link.is-at .nav-text { color: var(--heading); }

  /* The rail belongs to the instrument, so it leaves with the instrument. */
  :global(html.machine-mode) .side-rail,
  :global(body.machine-mode) .side-rail { opacity: 0; pointer-events: none; }
  .side-rail { transition: opacity 0.5s var(--ease-out); }

  /* Reduced motion: fall back to the static list this replaces — no
     stepping, no windowing, just the active label highlighted in place among
     all six, all visible at once. */
  @media (prefers-reduced-motion: reduce) {
    .rail-progress { display: none; }
    .rail-window { overflow: visible; height: auto; }
    .rail-stack { transform: none; transition: none; }
    .nav-link,
    .rail-no,
    .nav-text { transition: none; }
  }
</style>

<script>
  const navLinks = document.querySelectorAll('.side-rail .nav-link');
  const stack = document.querySelector('.rail-stack');
  const navIds = new Set([...navLinks].map((l) => l.getAttribute('data-section')));
  const sectionEls = [...document.querySelectorAll('section[id]')].filter((s) => navIds.has(s.id));

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const idx = [...navLinks].findIndex((l) => l.getAttribute('data-section') === entry.target.id);
        navLinks.forEach((link, i) => link.classList.toggle('is-at', i === idx));
        // Drives the window-centred stepping via CSS calc() — see .rail-stack.
        // A no-op under reduced motion, where .rail-stack transform is forced
        // to none regardless of --i.
        if (idx !== -1) stack?.style.setProperty('--i', String(idx));
      });
    },
    { rootMargin: '-40% 0px -60% 0px' },
  );
  sectionEls.forEach((s) => observer.observe(s));
</script>
